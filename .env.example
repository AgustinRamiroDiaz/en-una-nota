# Spotify Web API Configuration
# Get your Client ID from https://developer.spotify.com/dashboard
#
# IMPORTANT: You need to add BOTH redirect URIs to your Spotify App settings:
# - http://127.0.0.1:3000 (for local development; Spotify rejects localhost)
# - https://agustinramirodiaz.github.io/en-una-nota (for production)

REACT_APP_SPOTIFY_CLIENT_ID=your_client_id_here

# For local development:
REACT_APP_REDIRECT_URI=http://127.0.0.1:3000

# Serve the dev server on the same origin as the redirect URI
HOST=127.0.0.1

# For production (GitHub Pages), update this to:
# REACT_APP_REDIRECT_URI=https://agustinramirodiaz.github.io/en-una-nota

# Game Configuration
# Default preview duration in milliseconds (default: 1000ms = 1 second)
REACT_APP_DEFAULT_PREVIEW_DURATION=1000
